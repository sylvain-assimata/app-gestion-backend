APP_NAME="App Gestion PME"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_gestion
DB_USERNAME=root
DB_PASSWORD=

# Domaines autorisés à utiliser les cookies/tokens Sanctum (frontend React)
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost

# Limite de tentatives de connexion (protection brute-force)
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=1
